{
  "expo": {
    "name": "BMZ AI",
    "slug": "bmz-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "bmzai",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.bmzai.app",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
